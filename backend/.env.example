# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_PATH=./data/bookmark-digest.db
EPUB_EXPORT_DIR=./epub-exports

# Image Handling
MAX_IMAGE_SIZE_MB=5
IMAGE_QUALITY=85
IMAGE_TIMEOUT_MS=10000

# Maximum accepted article HTML size. Also caps the request body size, so the
# parser and the validator always agree.
MAX_ARTICLE_SIZE_MB=10

# Diagnostic. When true, every capture is written verbatim to
# backend/data/raw-captures/<title>-<url-hash>.html before extraction. It is the only way
# to tell which graphic Readability or the sanitiser threw away, since the census
# counts them but cannot name them. Off by default: each file can be as large as
# MAX_ARTICLE_SIZE_MB, and a capture holds more than the article.
DEBUG_SAVE_RAW_HTML=false

# Kindle/SMTP
KINDLE_EMAIL=your_kindle_email@kindle.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com

# Security
CORS_ORIGIN=http://localhost:5174
API_RATE_LIMIT=100
